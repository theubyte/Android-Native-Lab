<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup="false" stops cloud backup but on Android 12+ not the transfer to
    a new device. Notebooks of minors stay out of both; moving devices goes
    through the app's own backup, which can be encrypted.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
